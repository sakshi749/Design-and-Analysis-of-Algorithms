\par
1. PERFORM MERGE SORT ON RANDOM ARRAY OF SIZE 100, 1000, 10000, 100000.\par
\par
//created by sakshi\par
#include <stdio.h>\par
#include <stdlib.h>\par
#include <time.h>\par
#include <math.h>\par
\par
#define SIZE 100\par
\par
void merge(int arr[], int l, int m, int r) \{\par
    int i, j, k;\par
    int n1 = m - l + 1;\par
    int n2 = r - m;\par
\par
    int L[n1], R[n2];\par
\par
    for (i = 0; i < n1; i++)\par
        L[i] = arr[l + i];\par
    for (j = 0; j < n2; j++)\par
        R[j] = arr[m + 1 + j];\par
\par
    i = 0;\par
    j = 0;\par
    k = l;\par
    while (i < n1 && j < n2) \{\par
        if (L[i] <= R[j]) \{\par
            arr[k] = L[i];\par
            i++;\par
        \} else \{\par
            arr[k] = R[j];\par
            j++;\par
        \}\par
        k++;\par
    \}\par
\par
    while (i < n1) \{\par
        arr[k] = L[i];\par
        i++;\par
        k++;\par
    \}\par
\par
    while (j < n2) \{\par
        arr[k] = R[j];\par
        j++;\par
        k++;\par
    \}\par
\}\par
void mergeSort(int arr[], int l, int r) \{\par
    if (l < r) \{\par
        int m = l + (r - l) / 2;\par
\par
        mergeSort(arr, l, m);\par
        mergeSort(arr, m + 1, r);\par
\par
        merge(arr, l, m, r);\par
    \}\par
\}\par
void printArray(int arr[], int size) \{\par
    for (int i = 0; i < size; i++)\par
        printf("%d ", arr[i]);\par
    printf("\\n");\par
\}\par
\par
int main() \{\par
    int arr[SIZE];\par
    srand(time(0));\par
\par
    for (int i = 0; i < SIZE; i++) \{\par
        arr[i] = rand() % 1000;\par
    \}\par
\par
    printf("Original array:\\n");\par
    printArray(arr, SIZE);\par
\par
    clock_t start, end;\par
    double cpu_time_used;\par
\par
    start = clock();\par
    mergeSort(arr, 0, SIZE - 1);\par
    end = clock();\par
\par
    cpu_time_used = ((double) (end - start)) / CLOCKS_PER_SEC;\par
\par
    printf("Sorted array:\\n");\par
    printArray(arr, SIZE);\par
\par
    printf("Time taken by Merge Sort: %f seconds\\n", cpu_time_used);\par
    double nlogn_time = SIZE * log(SIZE);\par
    printf("n*log(n) comparison value: %f\\n", nlogn_time);\par
\par
    return 0;\par
\}\par
